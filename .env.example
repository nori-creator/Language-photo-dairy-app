# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# These two values are SAFE to expose in the app bundle (they are public by
# design). The actual Gemini API key is NOT here — it lives only as a Supabase
# Edge Function secret (see README → 実AI接続の手順).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
